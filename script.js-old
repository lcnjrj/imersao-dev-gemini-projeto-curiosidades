let cardContainer = document.querySelector(".card-container");
let campoBusca = document.querySelector("header input");
let dados = [];

async function iniciarBusca() {
    if (dados.length === 0) {
        try {
            let resposta = await fetch("data.json");
            dados = await resposta.json();
            console.log('Dados carregados:', dados.length);
        } catch (error) {
            console.error("Erro ao carregar dados:", error);
            return;
        }
    }

    const termoBusca = campoBusca.value.toLowerCase();
    const dadosFiltrados = dados.filter(dado => 
        dado.titulo.toLowerCase().includes(termoBusca) || 
        dado.curiosidade.toLowerCase().includes(termoBusca) ||
        dado.temas.some(tema => tema.toLowerCase().includes(termoBusca))
    );

    renderizarCards(dadosFiltrados);
}

function renderizarCards(dados) {
    cardContainer.innerHTML = "";
    
    if (dados.length === 0) {
        cardContainer.innerHTML = '<p style="text-align:center;">Nenhuma curiosidade encontrada</p>';
        return;
    }
    
    dados.forEach(dado => {
        let article = document.createElement("article");
        article.classList.add("card");
        
        const tagsHtml = dado.temas.map(tema => 
            `<span style="display:inline-block; background:#0088A8; color:white; padding:2px 8px; border-radius:3px; font-size:0.8rem; margin-right:5px; margin-bottom:5px;">#${tema}</span>`
        ).join(' ');
        
        article.innerHTML = `
        <h2>${dado.titulo}</h2>
        <p><strong>ID:</strong> ${dado.id}</p>
        <p>${dado.curiosidade}</p>
        <div style="margin-top:1rem;">${tagsHtml}</div>
        <p style="font-size:0.9em; color:var(--tertiary-color); margin-top:1rem;">💡 ${dado.fonte_sugerida}</p>
        `;
        cardContainer.appendChild(article);
    });
}

document.addEventListener('DOMContentLoaded', iniciarBusca);